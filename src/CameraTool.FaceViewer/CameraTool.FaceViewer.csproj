<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <StartupObject>CameraTool.FaceViewer.Program</StartupObject>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <SatelliteResourceLanguages>en;ja</SatelliteResourceLanguages>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CodeAnalysisRuleSet>..\..\Analyzers.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BunnyTail.DependencyInjection" Version="0.10.0" />
    <PackageReference Include="BunnyTail.XamlProperty.Wpf" Version="1.5.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.13" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="System.Reactive" Version="7.0.0" />
    <PackageReference Include="Usa.Smart.Core" Version="2.20.0" />
    <PackageReference Include="Usa.Smart.Mvvm" Version="2.17.0" />
    <PackageReference Include="Usa.Smart.Reactive" Version="2.15.0" />
    <PackageReference Include="Usa.Smart.Windows" Version="2.34.0" />
    <PackageReference Include="Usa.Smart.Windows.Extensions" Version="2.34.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CameraTool.Capture\CameraTool.Capture.csproj" />
    <ProjectReference Include="..\CameraTool.Vision\CameraTool.Vision.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.ComponentModel" />
    <Using Include="System.ComponentModel.DataAnnotations" />
    <Using Include="System.Globalization" />
    <Using Include="System.IO" />
    <Using Include="System.Runtime" />
    <Using Include="System.Windows" />
    <Using Include="System.Windows.Media" />
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="Smart.Mvvm" />
    <Using Include="Smart.Mvvm.ViewModels" />
    <Using Include="Smart.Windows.Input" />
    <Using Include="Smart.Windows.ViewModels" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>True</ExcludeFromSingleFile>
    </Content>
    <Content Include="appsettings.*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
      <DependentUpon>appsettings.json</DependentUpon>
      <ExcludeFromSingleFile>True</ExcludeFromSingleFile>
    </Content>
    <Content Include="version-RFB-320.onnx;version-RFB-320-LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>True</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

</Project>
