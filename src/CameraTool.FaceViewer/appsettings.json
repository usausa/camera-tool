{
  "Camera": {
    "Name": "ELECOM 2MP Webcam",
    "Format": "Yuy2",
    "Width": 640,
    "Height": 480,
    "Fps": 30,
    "Conversion": "Software"
  },

  "Display": {
    "UpdateMode": "Immediate"
  },

  "Detect": {
    "Enable": true,
    "Model": "version-RFB-320.onnx",
    "ConfidenceThreshold": 0.7,
    "IouThreshold": 0.3,
    "IntraOpNumThreads": 1,
    "InterOpNumThreads": 1
  },

  "Serilog": {
    "Using": [
      "Serilog.Sinks.File"
    ],
    "Enrich": [ "FromLogContext", "WithThreadId" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "..\\Log\\CameraTool\\CameraTool.FaceViewer_.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:HH:mm:ss.fff} {Level:u4} [{ThreadId}] - {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
