<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:s="http://smart/windows"
        xmlns:app="clr-namespace:CameraTool.FaceViewer"
        xmlns:controls="clr-namespace:CameraTool.FaceViewer.Controls"
        mc:Ignorable="d"
        x:Class="CameraTool.FaceViewer.MainWindow"
        s:DataContextResolver.Type="{x:Type app:MainWindowViewModel}"
        d:DataContext="{d:DesignInstance Type={x:Type app:MainWindowViewModel}}"
        Width="1280" Height="960" MinWidth="960" MinHeight="600"
        Title="Face Viewer">

    <Window.Resources>

        <!-- Panel -->

        <Style x:Key="PanelHeaderTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,10,0,4" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="PanelComboBox"
               TargetType="{x:Type ComboBox}"
               BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="PanelButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="88" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <!-- Takes no space while there is no error, a long message is cut at 3 lines (the whole message is in the tool tip) -->
        <Style x:Key="ErrorTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="MaxHeight" Value="57" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="LineHeight" Value="19" />
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <Style.Triggers>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Statistics -->

        <Style x:Key="StatisticsLabelTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,1,12,1" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- ValueText (redrawn every second without the text layout of TextBlock), or TextBlock for a value that wraps -->
        <Style x:Key="StatisticsValue"
               TargetType="{x:Type FrameworkElement}">
            <Setter Property="Margin" Value="0,1,0,1" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextElement.FontFamily" Value="Cascadia Mono, Consolas" />
        </Style>

        <!-- Next to the header -->
        <Style x:Key="StatisticsNoteTextBlock"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- Video -->
        <Border Grid.Column="0"
                Background="Black">
            <Grid>
                <controls:VideoView Source="{Binding Frames}"
                                    UpdateMode="{Binding SelectedUpdateMode}" />
                <controls:AreaOverlay Source="{Binding Area}"
                                      IsEditing="{Binding IsAreaEditing}"
                                      FrameWidth="{Binding FrameWidth}"
                                      FrameHeight="{Binding FrameHeight}" />
                <controls:MotionOverlay Source="{Binding Motion}" />
                <controls:ObjectBoxOverlay Source="{Binding ObjectDetection}" />
                <controls:FaceBoxOverlay Source="{Binding FaceDetection}" />
            </Grid>
        </Border>

        <!-- Panel -->
        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,0,16,16">

                <!-- Camera -->
                <TextBlock Style="{StaticResource PanelHeaderTextBlock}"
                           Text="Camera" />
                <ComboBox Style="{StaticResource PanelComboBox}"
                          ItemsSource="{Binding Devices}"
                          IsEnabled="{Binding IsRunning, Converter={StaticResource ReverseConverter}}"
                          DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedDevice}" />
                <ComboBox Style="{StaticResource PanelComboBox}"
                          ItemsSource="{Binding Formats}"
                          IsEnabled="{Binding IsRunning, Converter={StaticResource ReverseConverter}}"
                          SelectedItem="{Binding SelectedFormat}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0"
                              Style="{StaticResource PanelComboBox}"
                              ToolTip="Conversion"
                              ItemsSource="{Binding Conversions}"
                              IsEnabled="{Binding IsRunning, Converter={StaticResource ReverseConverter}}"
                              SelectedItem="{Binding SelectedConversion}" />
                    <ComboBox Grid.Column="2"
                              Style="{StaticResource PanelComboBox}"
                              ToolTip="Display update"
                              ItemsSource="{Binding UpdateModes}"
                              SelectedItem="{Binding SelectedUpdateMode}" />
                </Grid>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource PanelButton}"
                            Command="{Binding StartCommand}"
                            Content="Start" />
                    <Button Style="{StaticResource PanelButton}"
                            Command="{Binding StopCommand}"
                            Content="Stop" />
                    <Button Style="{StaticResource PanelButton}"
                            Command="{Binding RefreshCommand}"
                            Content="Refresh" />
                </StackPanel>
                <TextBlock Style="{StaticResource ErrorTextBlock}"
                           Text="{Binding ErrorMessage}" />

                <!-- Detection -->
                <TextBlock Style="{StaticResource PanelHeaderTextBlock}"
                           Text="Detection" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <CheckBox Grid.Row="0" Grid.Column="0"
                              Content="Face detection"
                              IsChecked="{Binding IsDetectionEnabled}" />
                    <CheckBox Grid.Row="0" Grid.Column="1"
                              Content="Object detection"
                              IsChecked="{Binding IsObjectDetectionEnabled}" />
                    <CheckBox Grid.Row="1" Grid.Column="0"
                              Content="Motion detection"
                              IsChecked="{Binding IsMotionEnabled}" />
                    <!-- Option of the motion detection -->
                    <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                              Margin="28,0,0,0"
                              Content="Detect only on motion"
                              IsEnabled="{Binding IsMotionEnabled}"
                              IsChecked="{Binding IsMotionGateEnabled}" />
                    <CheckBox Grid.Row="3" Grid.Column="0"
                              Content="Edit area"
                              IsEnabled="{Binding IsRunning}"
                              IsChecked="{Binding IsAreaEditing}" />
                    <Button Grid.Row="3" Grid.Column="1"
                            Style="{StaticResource PanelButton}"
                            Command="{Binding ResetAreaCommand}"
                            Content="Reset area" />
                </Grid>
                <TextBlock Style="{StaticResource ErrorTextBlock}"
                           Text="{Binding FaceStatistics.Error}" />
                <TextBlock Style="{StaticResource ErrorTextBlock}"
                           Text="{Binding ObjectStatistics.Error}" />
                <TextBlock Style="{StaticResource ErrorTextBlock}"
                           Text="{Binding AreaError}" />

                <!-- Statistics -->
                <Grid>
                    <TextBlock Style="{StaticResource PanelHeaderTextBlock}"
                               Text="Statistics" />
                    <TextBlock Style="{StaticResource StatisticsNoteTextBlock}"
                               Text="Latency / Process: average / max" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Style="{StaticResource StatisticsLabelTextBlock}"
                               Text="Format" />
                    <controls:ValueText Grid.Row="0" Grid.Column="1"
                                        Style="{StaticResource StatisticsValue}"
                                        Text="{Binding RunningFormat, TargetNullValue='-'}" />

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Style="{StaticResource StatisticsLabelTextBlock}"
                               Text="Output" />
                    <controls:ValueText Grid.Row="1" Grid.Column="1"
                                        Style="{StaticResource StatisticsValue}"
                                        Text="{Binding RunningOutput, TargetNullValue='-'}" />

                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Style="{StaticResource StatisticsLabelTextBlock}"
                               Text="Capture" />
                    <controls:ValueText Grid.Row="2" Grid.Column="1"
                                        Style="{StaticResource StatisticsValue}"
                                        Text="{Binding CaptureFps, StringFormat={}{0:F1} fps}" />

                    <TextBlock Grid.Row="3" Grid.Column="0"
                               Style="{StaticResource StatisticsLabelTextBlock}"
                               Text="Display" />
                    <controls:ValueText Grid.Row="3" Grid.Column="1"
                                        Style="{StaticResource StatisticsValue}"
                                        Text="{Binding DisplayFps, StringFormat={}{0:F1} fps}" />

                    <TextBlock Grid.Row="4" Grid.Column="0"
                               Style="{StaticResource StatisticsLabelTextBlock}"
                               Text="Capture latency" />
                    <controls:ValueText Grid.Row="4" Grid.Column="1"
                                        Style="{StaticResource StatisticsValue}"
                                        Text="{Binding CaptureLatency, StringFormat={}{0:F1} ms}" />

                    <TextBlock Grid.Row="5" Grid.Column="0"
                               Style="{StaticResource StatisticsLabelTextBlock}"
                               Text="Process" />
                    <controls:ValueText Grid.Row="5" Grid.Column="1"
                                        Style="{StaticResource StatisticsValue}"
                                        Text="{Binding ProcessTime, StringFormat={}{0:F2} ms}" />

                    <TextBlock Grid.Row="6" Grid.Column="0"
                               Style="{StaticResource StatisticsLabelTextBlock}"
                               Text="Display latency" />
                    <controls:ValueText Grid.Row="6" Grid.Column="1"
                                        Style="{StaticResource StatisticsValue}"
                                        Text="{Binding DisplayLatency, StringFormat={}{0:F1} ms}" />

                    <TextBlock Grid.Row="7" Grid.Column="0"
                               Style="{StaticResource StatisticsLabelTextBlock}"
                               Text="CPU" />
                    <controls:ValueText Grid.Row="7" Grid.Column="1"
                                        Style="{StaticResource StatisticsValue}"
                                        Text="{Binding CpuUsage, StringFormat={}{0:F1} %}" />

                    <TextBlock Grid.Row="8" Grid.Column="0"
                               Style="{StaticResource StatisticsLabelTextBlock}"
                               Text="Allocated" />
                    <controls:ValueText Grid.Row="8" Grid.Column="1"
                                        Style="{StaticResource StatisticsValue}"
                                        Text="{Binding AllocatedPerSec, StringFormat={}{0:F1} KB/s}" />

                    <TextBlock Grid.Row="9" Grid.Column="0"
                               Style="{StaticResource StatisticsLabelTextBlock}"
                               Text="GC 0/1/2" />
                    <controls:ValueText Grid.Row="9" Grid.Column="1"
                                        Style="{StaticResource StatisticsValue}">
                        <controls:ValueText.Text>
                            <MultiBinding StringFormat="{}{0:F1} / {1:F1} / {2:F1} /s">
                                <Binding Path="Gc0PerSec" />
                                <Binding Path="Gc1PerSec" />
                                <Binding Path="Gc2PerSec" />
                            </MultiBinding>
                        </controls:ValueText.Text>
                    </controls:ValueText>

                    <TextBlock Grid.Row="10" Grid.Column="0"
                               Style="{StaticResource StatisticsLabelTextBlock}"
                               Text="Detect" />
                    <controls:ValueText Grid.Row="10" Grid.Column="1"
                                        Style="{StaticResource StatisticsValue}"
                                        Text="{Binding FaceStatistics.Fps, StringFormat={}{0:F1} fps}" />

                    <TextBlock Grid.Row="11" Grid.Column="0"
                               Style="{StaticResource StatisticsLabelTextBlock}"
                               Text="Preprocess" />
                    <controls:ValueText Grid.Row="11" Grid.Column="1"
                                        Style="{StaticResource StatisticsValue}"
                                        Text="{Binding FaceStatistics.PreprocessTime, StringFormat={}{0:F2} ms}" />

                    <TextBlock Grid.Row="12" Grid.Column="0"
                               Style="{StaticResource StatisticsLabelTextBlock}"
                               Text="Inference" />
                    <controls:ValueText Grid.Row="12" Grid.Column="1"
                                        Style="{StaticResource StatisticsValue}"
                                        Text="{Binding FaceStatistics.InferenceTime, StringFormat={}{0:F2} ms}" />

                    <TextBlock Grid.Row="13" Grid.Column="0"
                               Style="{StaticResource StatisticsLabelTextBlock}"
                               Text="Faces" />
                    <controls:ValueText Grid.Row="13" Grid.Column="1"
                                        Style="{StaticResource StatisticsValue}"
                                        Text="{Binding FaceStatistics.Results}" />

                    <TextBlock Grid.Row="14" Grid.Column="0"
                               Style="{StaticResource StatisticsLabelTextBlock}"
                               Text="Motion" />
                    <controls:ValueText Grid.Row="14" Grid.Column="1"
                                        Style="{StaticResource StatisticsValue}">
                        <controls:ValueText.Text>
                            <MultiBinding StringFormat="{}{0} {1:F1} %">
                                <Binding Path="MotionStatus" />
                                <Binding Path="MotionLevel" />
                            </MultiBinding>
                        </controls:ValueText.Text>
                    </controls:ValueText>

                    <TextBlock Grid.Row="15" Grid.Column="0"
                               Style="{StaticResource StatisticsLabelTextBlock}"
                               Text="Motion time" />
                    <controls:ValueText Grid.Row="15" Grid.Column="1"
                                        Style="{StaticResource StatisticsValue}"
                                        Text="{Binding MotionTime, StringFormat={}{0:F2} ms}" />

                    <TextBlock Grid.Row="16" Grid.Column="0"
                               Style="{StaticResource StatisticsLabelTextBlock}"
                               Text="Area" />
                    <controls:ValueText Grid.Row="16" Grid.Column="1"
                                        Style="{StaticResource StatisticsValue}"
                                        Text="{Binding AreaStatus}" />

                    <TextBlock Grid.Row="17" Grid.Column="0"
                               Style="{StaticResource StatisticsLabelTextBlock}"
                               Text="Object detect" />
                    <controls:ValueText Grid.Row="17" Grid.Column="1"
                                        Style="{StaticResource StatisticsValue}"
                                        Text="{Binding ObjectStatistics.Fps, StringFormat={}{0:F1} fps}" />

                    <TextBlock Grid.Row="18" Grid.Column="0"
                               Style="{StaticResource StatisticsLabelTextBlock}"
                               Text="Object preprocess" />
                    <controls:ValueText Grid.Row="18" Grid.Column="1"
                                        Style="{StaticResource StatisticsValue}"
                                        Text="{Binding ObjectStatistics.PreprocessTime, StringFormat={}{0:F2} ms}" />

                    <TextBlock Grid.Row="19" Grid.Column="0"
                               Style="{StaticResource StatisticsLabelTextBlock}"
                               Text="Object inference" />
                    <controls:ValueText Grid.Row="19" Grid.Column="1"
                                        Style="{StaticResource StatisticsValue}"
                                        Text="{Binding ObjectStatistics.InferenceTime, StringFormat={}{0:F2} ms}" />

                    <TextBlock Grid.Row="20" Grid.Column="0"
                               Style="{StaticResource StatisticsLabelTextBlock}"
                               Text="Objects" />
                    <TextBlock Grid.Row="20" Grid.Column="1"
                               Style="{StaticResource StatisticsValue}"
                               TextWrapping="Wrap"
                               Text="{Binding ObjectStatistics.Results}" />
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
